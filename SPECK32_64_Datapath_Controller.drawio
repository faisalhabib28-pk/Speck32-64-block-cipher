  <diagram id="speck-top" name="SPECK32_64 Architecture">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="SPECK32/64 — Iterative Datapath + Controller (22 rounds)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="20" width="560" height="40" as="geometry"/></mxCell>

        <mxCell id="io" value="TOP-LEVEL INTERFACE&#xa;clk&#xa;rst_n&#xa;start&#xa;key_in[63:0] = {k3,k2,k1,k0}&#xa;plaintext[31:0] = {x0,y0}&#xa;ciphertext[31:0]&#xa;valid_out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="230" height="240" as="geometry"/></mxCell>

        <mxCell id="fsm" value="CONTROLLER / FSM&#xa;&#xa;IDLE → RUN → DONE → IDLE&#xa;&#xa;IDLE: accept start, load inputs&#xa;RUN: rounds 0..21&#xa;DONE: valid_out = 1&#xa;&#xa;round_ctr[4:0]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="350" y="130" width="270" height="260" as="geometry"/></mxCell>

        <mxCell id="xreg" value="x_reg[15:0]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="710" y="115" width="150" height="55" as="geometry"/></mxCell>
        <mxCell id="yreg" value="y_reg[15:0]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="710" y="225" width="150" height="55" as="geometry"/></mxCell>
        <mxCell id="rkreg" value="rk_reg[15:0]&#xa;current round key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="710" y="355" width="150" height="70" as="geometry"/></mxCell>
        <mxCell id="lreg" value="l_reg[15:0]&#xa;current l[i]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="710" y="500" width="150" height="70" as="geometry"/></mxCell>

        <mxCell id="enc" value="ENCRYPTION ROUND DATAPATH&#xa;&#xa;ROTR(x,7) → 16-bit ADD + y → XOR rk&#xa;                               ↓&#xa;                       x_next[15:0]&#xa;&#xa;ROTL(y,2) → XOR x_next → y_next[15:0]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="940" y="95" width="370" height="240" as="geometry"/></mxCell>

        <mxCell id="ks" value="KEY SCHEDULE DATAPATH&#xa;&#xa;ROTR(l,7) → 16-bit ADD + rk → XOR round_index&#xa;                                  ↓&#xa;                         l_next[15:0] = l[i+3]&#xa;&#xa;ROTL(rk,2) → XOR l_next → rk_next[15:0]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="940" y="400" width="370" height="240" as="geometry"/></mxCell>

        <mxCell id="out" value="OUTPUT REGISTER&#xa;ciphertext[31:0] = {x_next,y_next}&#xa;&#xa;valid_out asserted in DONE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1360" y="175" width="200" height="130" as="geometry"/></mxCell>

        <mxCell id="clock" value="CONTROL: clk, rst_n, start" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="350" y="450" width="270" height="70" as="geometry"/></mxCell>

